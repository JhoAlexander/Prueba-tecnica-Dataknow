# .gitignore

# --- Documentos locales (no versionar PDFs) ---
*.pdf
*.PDF

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Secretos y credenciales  ---
.env
.env.*
*.env
secrets/
credentials.json
*.pem
*.key
*.pfx
*.crt
service-account-*.json
azure-credentials.json

# --- Terraform / IaC state  ---
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars
*.auto.tfvars
crash.log
override.tf
override.tf.json

# --- Bicep ---
*.bicepparam.local


# --- Datasets generados  ---
data-generation/output/
data-generation/data/
*.parquet
*.csv
*.tsv
*.jsonl
# SI muestras pequenas para evidencia:
!data-generation/muestras/*
!docs/*.csv

# --- Logs y temporales ---
*.log
logs/
*.tmp
*.bak
*~

# --- Fabric / Jupyter ---
.ipynb_checkpoints/
.fabric/

# --- Dependencias node ---
node_modules/
dist/
build/

# --- OS especificos ---
desktop.ini
$RECYCLE.BIN/
